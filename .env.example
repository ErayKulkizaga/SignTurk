# Copy this file to .env. Never commit the populated .env file.

# Leave blank to use local SQLite. PostgreSQL/Supabase is supported through
# SQLAlchemy's psycopg driver.
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional administrator bootstrap. The account is created only when both
# email and an 8+ character password are provided.
SIGNTURK_ADMIN_NAME=SignTurk Admin
SIGNTURK_ADMIN_EMAIL=
SIGNTURK_ADMIN_PASSWORD=

# Optional Hugging Face-assisted Turkish grammar correction.
HF_TOKEN=
SIGNAI_USE_ML_GRAMMAR=0
SIGNAI_GRAMMAR_MODEL_KEY=qwen2.5-7b-api

# TTS defaults to gTTS. Set these only when using an offline Piper voice.
SIGNAI_TTS_ENGINE=auto
SIGNAI_PIPER_VOICE=
